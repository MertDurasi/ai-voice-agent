{
  "components": {
    "schemas": {
      "ApiErrorDetailDto": {
        "properties": {
          "code": {
            "example": "invalid_request",
            "type": "string"
          },
          "field": {
            "example": "fieldName",
            "type": "string"
          }
        },
        "required": ["code"],
        "type": "object"
      },
      "ApiErrorResponseDto": {
        "properties": {
          "code": {
            "example": "NOT_FOUND",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetailDto"
            },
            "type": "array"
          },
          "message": {
            "example": "Resource not found.",
            "type": "string"
          },
          "requestId": {
            "example": "0193f8d7-7f03-7f25-a4c0-f043f3d78a50",
            "type": "string"
          },
          "status": {
            "example": 404,
            "type": "number"
          }
        },
        "required": ["code", "message", "requestId", "status"],
        "type": "object"
      },
      "ApiRootResponseDto": {
        "properties": {
          "service": {
            "example": "voice-ai-api",
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "example": "ok",
            "type": "string"
          },
          "version": {
            "enum": ["v1"],
            "example": "v1",
            "type": "string"
          }
        },
        "required": ["service", "status", "version"],
        "type": "object"
      },
      "DependencyStatusDto": {
        "properties": {
          "latencyMs": {
            "example": 2,
            "minimum": 0,
            "type": "number"
          },
          "status": {
            "enum": ["down", "up"],
            "type": "string"
          }
        },
        "required": ["latencyMs", "status"],
        "type": "object"
      },
      "LivenessResponseDto": {
        "properties": {
          "checkedAt": {
            "example": "2026-08-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "service": {
            "example": "voice-ai-api",
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["checkedAt", "service", "status"],
        "type": "object"
      },
      "ReadinessDependenciesDto": {
        "properties": {
          "postgres": {
            "$ref": "#/components/schemas/DependencyStatusDto"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyStatusDto"
          }
        },
        "required": ["postgres", "redis"],
        "type": "object"
      },
      "ReadinessResponseDto": {
        "properties": {
          "checkedAt": {
            "example": "2026-08-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "dependencies": {
            "$ref": "#/components/schemas/ReadinessDependenciesDto"
          },
          "status": {
            "enum": ["not_ready", "ready"],
            "type": "string"
          }
        },
        "required": ["checkedAt", "dependencies", "status"],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Providerfreie, synthetische Foundation API.",
    "title": "Voice AI Agent API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "ApiController_getRoot",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiRootResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Describe the stable API baseline",
        "tags": ["system"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Report process liveness without checking dependencies",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Report PostgreSQL and Redis reachability",
        "tags": ["health"]
      }
    }
  },
  "servers": [],
  "tags": []
}
