# Runtime profile shared by API, worker and web.
# Allowed: development | test | staging | production
APP_ENV=development

# API runtime
API_HOST=127.0.0.1
API_PORT=3001
API_LOG_LEVEL=debug
DEPENDENCY_PROBE_TIMEOUT_MS=500
SHUTDOWN_GRACE_PERIOD_MS=5000

# Local-only infrastructure credentials. These deterministic placeholders are
# not secrets and must be replaced by an approved secret source outside local use.
DATABASE_URL=postgresql://voice_ai_local:local-only-postgres-change-before-real-data@127.0.0.1:5432/voice_ai_local
REDIS_URL=redis://:local-only-redis-change-before-real-data@127.0.0.1:6379
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/voice-ai-local
OIDC_CLIENT_ID=voice-ai-api-local
OIDC_CLIENT_SECRET=replace-with-local-oidc-client-secret
SESSION_SECRET=replace-with-at-least-32-random-local-bytes

# Worker runtime
WORKER_LOG_LEVEL=debug
WORKER_READINESS_INTERVAL_MS=2000

# Browser-visible configuration; never put credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://127.0.0.1:3000
