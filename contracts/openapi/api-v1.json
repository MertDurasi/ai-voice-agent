{
  "components": {
    "schemas": {
      "ApiErrorDetailDto": {
        "properties": {
          "code": {
            "example": "invalid_request",
            "type": "string"
          },
          "field": {
            "example": "fieldName",
            "type": "string"
          }
        },
        "required": ["code"],
        "type": "object"
      },
      "ApiErrorResponseDto": {
        "properties": {
          "code": {
            "example": "NOT_FOUND",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetailDto"
            },
            "type": "array"
          },
          "message": {
            "example": "Resource not found.",
            "type": "string"
          },
          "requestId": {
            "example": "0193f8d7-7f03-7f25-a4c0-f043f3d78a50",
            "type": "string"
          },
          "status": {
            "example": 404,
            "type": "number"
          }
        },
        "required": ["code", "message", "requestId", "status"],
        "type": "object"
      },
      "ApiRootResponseDto": {
        "properties": {
          "service": {
            "example": "voice-ai-api",
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "example": "ok",
            "type": "string"
          },
          "version": {
            "enum": ["v1"],
            "example": "v1",
            "type": "string"
          }
        },
        "required": ["service", "status", "version"],
        "type": "object"
      },
      "DependencyStatusDto": {
        "properties": {
          "latencyMs": {
            "example": 2,
            "minimum": 0,
            "type": "number"
          },
          "status": {
            "enum": ["down", "up"],
            "type": "string"
          }
        },
        "required": ["latencyMs", "status"],
        "type": "object"
      },
      "IdentityResponseDto": {
        "properties": {
          "roles": {
            "items": {
              "enum": ["agent", "support_admin", "tenant_admin", "tenant_owner", "viewer"],
              "type": "string"
            },
            "type": "array"
          },
          "subject": {
            "example": "f25c47ed-6f91-469b-865a-84f42b088a7d",
            "type": "string"
          },
          "tenantContext": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": ["roles", "subject", "tenantContext"],
        "type": "object"
      },
      "LivenessResponseDto": {
        "properties": {
          "checkedAt": {
            "example": "2026-08-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "service": {
            "example": "voice-ai-api",
            "type": "string"
          },
          "status": {
            "enum": ["ok"],
            "type": "string"
          }
        },
        "required": ["checkedAt", "service", "status"],
        "type": "object"
      },
      "ReadinessDependenciesDto": {
        "properties": {
          "postgres": {
            "$ref": "#/components/schemas/DependencyStatusDto"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyStatusDto"
          }
        },
        "required": ["postgres", "redis"],
        "type": "object"
      },
      "ReadinessResponseDto": {
        "properties": {
          "checkedAt": {
            "example": "2026-08-10T12:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "dependencies": {
            "$ref": "#/components/schemas/ReadinessDependenciesDto"
          },
          "status": {
            "enum": ["not_ready", "ready"],
            "type": "string"
          }
        },
        "required": ["checkedAt", "dependencies", "status"],
        "type": "object"
      },
      "TenantContextResponseDto": {
        "properties": {
          "membershipId": {
            "example": "0193f8d7-7f03-7f25-a4c0-f043f3d78a52",
            "format": "uuid",
            "type": "string"
          },
          "membershipVersion": {
            "example": 1,
            "minimum": 1,
            "type": "number"
          },
          "permissions": {
            "items": {
              "enum": [
                "tenant:read",
                "tenant:manage",
                "members:read",
                "members:manage",
                "work:read",
                "work:write"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "role": {
            "enum": ["tenant_owner", "tenant_admin", "agent", "viewer"],
            "type": "string"
          },
          "tenantId": {
            "example": "0193f8d7-7f03-7f25-a4c0-f043f3d78a50",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["membershipId", "membershipVersion", "permissions", "role", "tenantId"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Providerfreie, synthetische Foundation API.",
    "title": "Voice AI Agent API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "ApiController_getRoot",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiRootResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Describe the stable API baseline",
        "tags": ["system"]
      }
    },
    "/api/v1/identity/me": {
      "get": {
        "operationId": "IdentityController_getIdentity",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Return the validated identity without a tenant context",
        "tags": ["identity"]
      }
    },
    "/api/v1/tenants/{tenantId}/context": {
      "get": {
        "operationId": "TenantContextController_getTenantContext",
        "parameters": [
          {
            "in": "path",
            "name": "tenantId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantContextResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Resolve the authoritative membership-backed tenant context",
        "tags": ["tenancy"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Report process liveness without checking dependencies",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            },
            "description": ""
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Report PostgreSQL and Redis reachability",
        "tags": ["health"]
      }
    }
  },
  "servers": [],
  "tags": []
}
